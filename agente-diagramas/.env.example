ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

INPUT_DIR=../agente-identificacao/data/output
OUTPUT_DIR=./data/output
PROCESSED_DIR=./data/processed

CHECK_INTERVAL=5
MAX_RETRIES=3

# Default document format when none is passed via --format.
# 'empresa' skips Agent 4 entirely (that format has no diagrams).
DOCUMENT_FORMAT=ieee
