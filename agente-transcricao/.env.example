# Transcription agent configuration

# Hugging Face (AMI dataset scripts)
HUGGINGFACE_TOKEN=your_token_here

# Groq — default transcription engine (create a key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
# Stay under Groq's 25 MB upload limit; files above this are split on silence.
GROQ_MAX_FILE_MB=24

# Local faster-whisper fallback (used when Groq is unavailable) — fast preset
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_BEAM_SIZE=1
