ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

INPUT_DIR=../agente-identificacao/data/output
OUTPUT_DIR=./data/output
PROCESSED_DIR=./data/processed

CHECK_INTERVAL=5
MAX_RETRIES=3

# Default document format when none is passed via --format.
# ieee    -> IEEE 830 SRS (srs.md.j2)
# empresa -> SGG-GO "Documento de Requisitos" (feature_requirements.md.j2)
DOCUMENT_FORMAT=ieee

# Empresa format: include the Non-Functional Requirements (RNF) section?
# The SGG model document has none. Default true; set to false to omit it.
EMPRESA_INCLUDE_NFR=true
